# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trading agent (python)
agent/.venv/
agent/__pycache__/
agent/**/__pycache__/
*.py[cod]
.pytest_cache/

# agent runtime state: credentials-adjacent session token, live audit log,
# and the local config with your real symbols and limits
agent/state/*
!agent/state/.gitkeep
agent/config.yaml
