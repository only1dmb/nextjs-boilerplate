# Copy to agent/.env and fill in. .env is gitignored -- never commit it.
#
#   cp agent/.env.example agent/.env

ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=

# Recommended: the TOTP secret from Robinhood's authenticator-app setup
# (Settings -> Security -> Two-Factor -> Authentication App -> "can't scan").
# With this set, the agent generates its own codes and can run unattended.
ROBINHOOD_TOTP_SECRET=

# Alternative to the TOTP secret for one-off interactive runs. You can also
# pass a code on the command line with --mfa.
# ROBINHOOD_MFA_CODE=

# The second key for autonomous live trading. Leave this unset until you have
# watched the agent in paper and confirm modes and read its journal.
# Setting it does nothing on its own -- config.yaml must also say mode: live.
# RH_AGENT_ARM_LIVE=I-ACCEPT-THE-RISK
